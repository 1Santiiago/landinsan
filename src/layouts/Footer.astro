---
import GroupFooterNav from "../components/blocks/GroupFooterNav.astro";
import Container from "../components/shared/Container.astro";
import FooterNav from "../components/shared/FooterNav.astro";
import Paragraph from "../components/shared/Paragraph.astro";

const footerServices = [
  { itemText: "Troca de Tela", itemLink: "#services" },
  { itemText: "Troca de Bateria", itemLink: "#services" },
  { itemText: "Reparo em Placa", itemLink: "#assistencia" },
  { itemText: "Atualização de Software", itemLink: "#services" },
];

const footerWeb = [
  { itemText: "Sites Profissionais", itemLink: "#services" },
  { itemText: "Landing Pages", itemLink: "#services" },
  { itemText: "Sistemas Web", itemLink: "#services" },
  { itemText: "Manutenção de Sites", itemLink: "#services" },
];

// const footerSupport = [
//   { itemText: "Acompanhar Reparo", itemLink: "#status" },
//   { itemText: "Orçamento", itemLink: "#contato" },
//   { itemText: "Perguntas Frequentes", itemLink: "#faq" },
//   { itemText: "Contato", itemLink: "#contato" },
// ];

// const footerLegal = [
//   { itemText: "Privacidade", itemLink: "#" },
//   { itemText: "Termos de Uso", itemLink: "#" },
// ];
---

<div class="relative mt-16 mx-auto">
  <footer
    class="relative bg-gradient-to-tr from-slate-100/85 to-zinc-200/85
    dark:from-slate-800/85 dark:to-zinc-800/85 pt-28 rounded-t-3xl backdrop-blur-md"
  >
    <Container className="pb-8 relative overflow-auto">
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Brand -->
        <div class="col-span-2 lg:col-span-1 flex flex-col">
          <a href="#" class="text-xl font-bold text-heading-1">
            Sam Dev & Tech
          </a>

          <Paragraph className="mt-6">
            Assistência técnica especializada em celulares e desenvolvimento de
            soluções web modernas. Tecnologia clara, rápida e sem enrolação.
          </Paragraph>

          <div class="flex gap-4 mt-8 text-heading-3">
            <a href="#" class="hover:text-heading-1 transition">WhatsApp</a>
            <!-- <a href="#" class="hover:text-heading-1 transition">Instagram</a>
            <a href="#" class="hover:text-heading-1 transition">GitHub</a> -->
          </div>
        </div>

        <!-- Navs -->
        <GroupFooterNav>
          <FooterNav title={"Assistência Técnica"} navItems={footerServices} />
          <FooterNav title={"Desenvolvimento Web"} navItems={footerWeb} />
        </GroupFooterNav>

        <!-- <GroupFooterNav>
          <FooterNav title={"Suporte"} navItems={footerSupport} />
          <FooterNav title={"Legal"} navItems={footerLegal} />
        </GroupFooterNav> -->
      </div>
    </Container>

    <div class="py-4 border-t border-black/10 dark:border-white/10">
      <Container>
        <div class="flex justify-between text-sm text-heading-3">
          <span>
            © <span id="year"></span> VibeTech. Todos os direitos reservados.
          </span>
          <span>
            Desenvolvido por <strong>VibeTech</strong>
          </span>
        </div>
      </Container>
    </div>
  </footer>
</div>
