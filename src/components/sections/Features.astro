---
import { Image } from "astro:assets";
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import Title from "../shared/Title.astro";

import myImage from "../../assets/images/dev-with-c-1.webp";
import GradiantText from "../shared/GradiantText.astro";

type FeatureProps = {
  title: string;
  description: string;
};
const features = [
  {
    title: "Diagnóstico técnico detalhado",
    description: "Identificação precisa do problema antes de qualquer reparo.",
  },
  {
    title: "Troca de tela e bateria",
    description: "Peças compatíveis e serviço realizado com cuidado técnico.",
  },
  {
    title: "Reparo de conector de carga",
    description: "Correção de falhas de carregamento e mau contato.",
  },
  {
    title: "Correções de software",
    description: "Atualizações, formatação e resolução de erros do sistema.",
  },
  {
    title: "Acompanhamento do serviço",
    description: "Atualizações claras sobre o andamento do reparo.",
  },
  {
    title: "Garantia no serviço",
    description: "Segurança e confiança após a entrega do aparelho.",
  },
  {
    title: "Desenvolvimento de sites profissionais",
    description: "Sites rápidos, responsivos e focados em funcionalidade.",
  },
  {
    title: "Landing pages sob medida",
    description: "Páginas criadas para apresentar serviços ou produtos.",
  },
  {
    title: "Sistemas simples e funcionais",
    description: "Soluções digitais práticas para necessidades reais.",
  },
  {
    title: "Código limpo e organizado",
    description: "Facilidade de manutenção e evolução do projeto.",
  },
  {
    title: "Tecnologias modernas",
    description: "Uso de ferramentas atuais e boas práticas.",
  },
  {
    title: "Suporte direto com o desenvolvedor",
    description: "Contato sem intermediários durante e após o projeto.",
  },
];

export interface Props {
  className?: string;
}

const { className } = Astro.props;
---

<section id="features" class=`${className}`>
  <Container className="">
    <div class="text-center max-w-3xl mx-auto">
      <Title>
        Soluções <GradiantText>Essenciais <br />em Tecnologia</GradiantText>
      </Title>
    </div>
    <div class="flex flex-row flex-wrap mt-8">
      <!-- <div class="flex flex-col lg:gap-10 lg:gap-12 midmd:flex-row mt-8"> -->
      <!-- <div class="flex  lg:w-1/2 flex-row"> -->
      {
        features.map((feature: FeatureProps) => {
          return (
            <div class="flex items-center text-heading-3 font-medium basis-full md:basis-1/2 lg:basis-1/3">
              <span class="font-bold rounded-full w-8 h-8 mr-3 text-primary inline-flex justify-center items-center">
                &checkmark;
              </span>
              {feature.title}
            </div>
          );
        })
      }
      <!-- </div> -->
    </div>
  </Container>
</section>
